{
  "manifest_version": 3,
  "name": "Focus Guard",
  "version": "0.1.0",
  "key": "",
  "description": "Personal focus companion: blocks distracting sites with motivational wallpapers, timed doses and a focus schedule.",
  "minimum_chrome_version": "116",
  "permissions": ["declarativeNetRequest", "storage", "alarms", "tabs", "unlimitedStorage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Focus Guard — Settings"
  },
  "options_ui": {
    "page": "src/pages/settings/settings.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/overlay-core.js", "src/content/focus-overlay.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
